<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.lambao.mrbeast.presentation.ui.fragment.home.HomeFragment"
        android:label="HomeFragment"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_animeDetailFragment"
            app:destination="@id/animeDetailFragment" />
        <action
            android:id="@+id/action_homeFragment_to_topAnimeListFragment"
            app:destination="@id/topAnimeListFragment" />
        <action
            android:id="@+id/action_homeFragment_to_seasonAnimeListFragment"
            app:destination="@id/seasonAnimeListFragment" />
        <action
            android:id="@+id/action_homeFragment_to_topTestFragment"
            app:destination="@id/topTestFragment" />
        <action
            android:id="@+id/action_homeFragment_to_animeSearchFragment"
            app:destination="@id/animeSearchFragment" />
        <action
            android:id="@+id/action_homeFragment_to_animeFilterBottomSheet"
            app:destination="@id/animeFilterBottomSheet" />
    </fragment>

    <fragment
        android:id="@+id/genresFragment"
        android:name="com.lambao.mrbeast.presentation.ui.fragment.genres.GenresFragment"
        android:label="GenresFragment"
        tools:layout="@layout/fragment_genres">
        <action
            android:id="@+id/action_genresFragment_to_animeDetailFragment"
            app:destination="@id/animeDetailFragment" />
        <action
            android:id="@+id/action_genresFragment_to_animeSearchFragment"
            app:destination="@id/animeSearchFragment" />
    </fragment>

    <dialog
        android:id="@+id/animeDetailFragment"
        android:name="com.lambao.mrbeast.presentation.ui.fragment.anime_detail.AnimeDetailFragment"
        android:label="AnimeDetailFragment"
        tools:layout="@layout/fragment_anime_detail" />

    <fragment
        android:id="@+id/topAnimeListFragment"
        android:name="com.lambao.mrbeast.presentation.ui.fragment.tops.TopAnimeListFragment"
        android:label="TopAnimeListFragment"
        tools:layout="@layout/fragment_top_anime_list">
        <action
            android:id="@+id/action_topAnimeListFragment_to_animeDetailFragment"
            app:destination="@id/animeDetailFragment" />
        <action
            android:id="@+id/action_topAnimeListFragment_to_animeSearchFragment"
            app:destination="@id/animeSearchFragment" />
    </fragment>

    <fragment
        android:id="@+id/seasonAnimeListFragment"
        android:name="com.lambao.mrbeast.presentation.ui.fragment.seasons.SeasonAnimeListFragment"
        android:label="SeasonAnimeListFragment"
        tools:layout="@layout/fragment_season_anime_list">
        <action
            android:id="@+id/action_seasonAnimeListFragment_to_animeDetailFragment"
            app:destination="@id/animeDetailFragment" />
        <action
            android:id="@+id/action_seasonAnimeListFragment_to_animeSearchFragment"
            app:destination="@id/animeSearchFragment" />
    </fragment>

    <fragment
        android:id="@+id/topTestFragment"
        android:name="com.lambao.mrbeast.presentation.ui.fragment.test.TopTestFragment"
        android:label="TopTestFragment" />

    <fragment
        android:id="@+id/animeSearchFragment"
        android:name="com.lambao.mrbeast.presentation.ui.fragment.anime_search.AnimeSearchFragment"
        android:label="AnimeSearchFragment"
        tools:layout="@layout/fragment_anime_search">
        <action
            android:id="@+id/action_animeSearchFragment_to_animeDetailFragment"
            app:destination="@id/animeDetailFragment" />
        <action
            android:id="@+id/action_animeSearchFragment_to_animeFilterBottomSheet"
            app:destination="@id/animeFilterBottomSheet" />
    </fragment>

    <dialog
        android:id="@+id/animeFilterBottomSheet"
        android:name="com.lambao.mrbeast.presentation.ui.fragment.anime_filter.AnimeFilterBottomSheet"
        android:label="AnimeFilterBottomSheet"
        tools:layout="@layout/fragment_anime_filter" />
</navigation>