<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="item"
            type="com.lambao.mrbeast.domain.model.display.genre.ColorfulGenre" />
    </data>

    <TextView
        style="@style/semibold_16"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_corner_4"
        android:backgroundTint="@{item.background}"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:text="@{item.data.displayTitle()}"
        android:textColor="@color/text_secondary"
        tools:backgroundTint="@color/red_700"
        tools:text="Action" />
</layout>