<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="item"
            type="com.lambao.mrbeast.domain.model.display.DisplayAnimeEpisodeInfo" />

        <import type="android.view.View" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="10dp"
        tools:background="@color/black">

        <ImageView
            android:id="@+id/ivThumbnail"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:adjustViewBounds="true"
            android:foreground="@drawable/bg_thumbnail_gradient"
            android:scaleType="centerCrop"
            app:cornerRadiusDp="@{4}"
            app:imageUrl="@{item.displayThumbnail()}"
            app:layout_constraintDimensionRatio="4:3"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.3"
            tools:src="@drawable/ic_launcher_background" />

        <TextView
            android:id="@+id/tvEpisode"
            style="@style/semibold_14"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:paddingBottom="2dp"
            android:text="@{@string/episode_with_value(item.displayEpisode())}"
            android:textColor="@color/text_secondary"
            android:visibility="@{item.shouldDisplayEpisode() ? View.VISIBLE : View.GONE, default=gone}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivThumbnail"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Episode 1"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvTitle"
            style="@style/medium_14"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@{item.displayTitle()}"
            android:textColor="@color/text_secondary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivThumbnail"
            app:layout_constraintTop_toBottomOf="@id/tvEpisode"
            tools:text="To You, 2,000 Years in the Future: The Fall of Shiganshina (1)" />

        <TextView
            android:id="@+id/tvTimeAired"
            style="@style/regular_12"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:text="@{@string/aired_at(item.displayTimeAired())}"
            android:textColor="@color/text_secondary"
            android:visibility="@{item.shouldDisplayTimeAired() ? View.VISIBLE : View.GONE, default=gone}"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivThumbnail"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            app:layout_constraintVertical_bias="1"
            tools:text="Phát sóng: 07/04/2013"
            tools:visibility="visible" />

        <include
            android:id="@+id/scoreView"
            layout="@layout/layout_small_score_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:visibility="@{item.shouldDisplayScore() ? View.VISIBLE : View.GONE, default=gone}"
            app:layout_constraintBottom_toBottomOf="@id/ivThumbnail"
            app:layout_constraintEnd_toEndOf="@id/ivThumbnail"
            app:score="@{item.displayScore()}"
            tools:visibility="visible" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>