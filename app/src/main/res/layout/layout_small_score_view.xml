<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="score"
            type="String" />

        <variable
            name="shouldShowArrowNext"
            type="Boolean" />

        <import type="android.view.View" />
    </data>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_corner_4"
        android:backgroundTint="@color/yellow_600"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        android:paddingVertical="2dp">

        <ImageView
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:adjustViewBounds="true"
            android:src="@drawable/ic_star_24"
            app:tint="@color/grey_900" />

        <TextView
            style="@style/semibold_10"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:text="@{score}"
            android:textColor="@color/grey_900"
            tools:text="3.6" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:adjustViewBounds="true"
            android:src="@drawable/ic_keyboard_arrow_right_16"
            android:visibility="@{shouldShowArrowNext ? View.VISIBLE : View.GONE, default=gone}" />
    </LinearLayout>
</layout>