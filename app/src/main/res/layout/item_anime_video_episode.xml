<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="item"
            type="com.lambao.mrbeast.domain.model.display.DisplayAnimeVideoEpisodeInfo" />

        <import type="android.view.View" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="10dp"
        tools:background="@color/black">

        <ImageView
            android:id="@+id/ivThumbnail"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:adjustViewBounds="true"
            android:scaleType="centerCrop"
            app:cornerRadiusDp="@{4}"
            app:imageUrl="@{item.displayThumbnail()}"
            app:layout_constraintDimensionRatio="4:3"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.36"
            tools:src="@drawable/ic_launcher_background" />

        <TextView
            android:id="@+id/tvEpisode"
            style="@style/semibold_14"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:paddingBottom="2dp"
            android:text="@{item.displayEpisode()}"
            android:textColor="@color/text_secondary"
            android:visibility="@{item.shouldDisplayEpisode() ? View.VISIBLE : View.GONE, default=gone}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivThumbnail"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Episode 1"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvTitle"
            style="@style/medium_14"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="12dp"
            android:paddingTop="2dp"
            android:gravity="center_vertical"
            android:text="@{item.displayTitle()}"
            android:textColor="@color/text_secondary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivThumbnail"
            app:layout_constraintTop_toBottomOf="@id/tvEpisode"
            android:ellipsize="end"
            tools:text="To You, 2,000 Years in the Future: The Fall of Shiganshina (1)" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>