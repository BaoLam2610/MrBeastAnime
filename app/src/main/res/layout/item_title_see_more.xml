<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="title"
            type="String" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            style="@style/medium_20"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="@{title}"
            android:textColor="@color/text_secondary"
            tools:text="Top 10 this month"
            tools:textColor="@color/text_primary" />

        <TextView
            style="@style/medium_12"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/see_more"
            android:textColor="@color/background_primary"
            app:drawableEndCompat="@drawable/ic_keyboard_arrow_right_16"
            app:drawableTint="@color/background_primary" />
    </LinearLayout>
</layout>