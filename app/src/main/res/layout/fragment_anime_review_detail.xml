<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="viewModel"
            type="com.lambao.mrbeast.presentation.ui.fragment.anime_rating.detail.AnimeReviewDetailViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:adjustViewBounds="true"
            android:background="@android:color/transparent"
            android:padding="6dp"
            android:src="@drawable/ic_arrow_back_24"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/background_secondary" />

        <TextView
            android:id="@+id/tvTitle"
            style="@style/semibold_18"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="52dp"
            android:adjustViewBounds="true"
            android:gravity="center"
            android:text="@string/info"
            android:textColor="@color/text_secondary"
            app:layout_constraintBottom_toBottomOf="@id/btnBack"
            app:layout_constraintTop_toTopOf="@id/btnBack" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnBack">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/ivAvatar"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginTop="2dp"
                    app:circleImageUrl="@{viewModel.review.displayUserAvatar()}"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:src="@color/red_300" />

                <TextView
                    android:id="@+id/tvUsername"
                    style="@style/medium_14"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:text="@{viewModel.review.displayUsername()}"
                    android:textColor="@color/text_secondary"
                    app:layout_constraintBottom_toTopOf="@id/tvDate"
                    app:layout_constraintEnd_toStartOf="@id/ivScore"
                    app:layout_constraintStart_toEndOf="@id/ivAvatar"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_chainStyle="spread"
                    tools:text="Eren Yeager" />

                <TextView
                    android:id="@+id/tvDate"
                    style="@style/medium_12"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:text="@{viewModel.review.displayReviewDate()}"
                    android:textColor="@color/text_disabled"
                    app:layout_constraintBottom_toBottomOf="@id/ivAvatar"
                    app:layout_constraintEnd_toStartOf="@id/ivScore"
                    app:layout_constraintStart_toEndOf="@id/ivAvatar"
                    app:layout_constraintTop_toBottomOf="@id/tvUsername"
                    tools:text="26/10/2000 00:00" />

                <ImageView
                    android:id="@+id/ivScore"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="4dp"
                    android:adjustViewBounds="true"
                    android:src="@drawable/ic_star_24"
                    app:layout_constraintBottom_toBottomOf="@id/ivAvatar"
                    app:layout_constraintEnd_toStartOf="@id/tvScore"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/yellow_600" />

                <TextView
                    android:id="@+id/tvScore"
                    style="@style/medium_14"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text="@{@string/score_in_10(viewModel.review.displayUserScoreRated())}"
                    android:textColor="@color/text_secondary"
                    app:layout_constraintBottom_toBottomOf="@id/ivAvatar"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="9/10" />

                <TextView
                    android:id="@+id/tvReview"
                    style="@style/medium_14"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@{viewModel.review.displayUserReview()}"
                    android:textColor="@color/text_secondary"
                    app:layout_constraintTop_toBottomOf="@id/ivAvatar"
                    tools:text="With lives so short, why do we even bother? To someone who lives for thousands of years, it is barely worth giving the wistful existence of humans much consideration, let alone getting to know them. That is, at least, until you meet one who is worth getting to know. From the very outset, this series does not hide that it will focus on some of the tough questions in life: purpose, meaning, our own endings. Yet embedded within these, it unpacks the many guised forms of regret. Upfront it reminds us that our lives are short; our prime is even shorter." />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvReactions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:layout_constraintTop_toBottomOf="@id/tvReview" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>